# 1. PostgreSQL 데이터베이스 연결 주소
# 형식: postgresql://[DB사용자명]:[비밀번호]@localhost:5432/[DB이름]?schema=public
# 주의: '비밀번호입력' 부분을 실제 PostgreSQL 설치 시 설정한 비밀번호로 변경하세요.
DATABASE_URL="postgresql://postgres:pw123@localhost:5432/smart_office?schema=public"
#DATABASE_URL="mysql://root:kpcqa1234!@localhost:3306/mydb"

# 2. JWT 인증(로그인)을 위한 암호화 키
# 회원님의 자체 로그인 로직(api/auth/login)에서 사용하는 키값입니다.
