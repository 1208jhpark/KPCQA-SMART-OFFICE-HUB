# Smart Office Hub — 배포 PC(.env) 예시
# 이 파일을 복사해 `.env` 로 저장한 뒤 값을 채우세요. (.env 는 git에 올리지 마세요)

# PostgreSQL (사내망)
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/smart_office?schema=public"

# JWT 서명 키 (프로덕션에서 미설정 시 서버가 기동/로그인 실패할 수 있음)
JWT_SECRET="change-me-to-a-long-random-string"

# 익명 설문 참여 HMAC 비밀값 (미설정 시 JWT_SECRET 사용)
# 배포 후 값을 바꾸면 기존 참여 해시와 불일치하므로 고정 유지하세요.
# SURVEY_ANON_HMAC_SECRET="change-me-survey-anon-hmac"

# 공개 접속 URL (사내 LAN HTTP 예: http://210.x.x.x:3000)
# HTTPS가 아니면 http:// 로 두어 쿠키 secure 플래그가 꺼지도록 합니다.
# 장비 QR 스캔 URL에도 사용됩니다. 미설정 시 브라우저 origin에 의존하므로
# 폐쇄망/폰 카메라 스캔용으로 사내 고정 URL을 반드시 설정하세요.
NEXT_PUBLIC_BASE_URL="http://127.0.0.1:3000"

# Node 환경
NODE_ENV="production"

# admin/interface 민감 설정 잠금 해제 (path · Entry Mode · View/Edit Scope)
# true = 수정 가능 / 미설정·false = 잠금(배포 권장)
# UI까지 열려면 NEXT_PUBLIC_ 도 true + build, API만이면 ALLOW_ 만으로도 서버 거부 해제
# ALLOW_INTERFACE_PATH_EDIT=true
# NEXT_PUBLIC_ALLOW_INTERFACE_PATH_EDIT=true
