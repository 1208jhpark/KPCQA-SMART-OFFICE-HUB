# Smart Office Hub — 배포 PC(.env) 예시
# 이 파일을 복사해 `.env` 로 저장한 뒤 값을 채우세요. (.env 는 git에 올리지 마세요)

# PostgreSQL (사내망)
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/smart_office_hub?schema=public"

# JWT 서명 키 (프로덕션에서 미설정 시 서버가 기동/로그인 실패할 수 있음)
JWT_SECRET="change-me-to-a-long-random-string"

# 공개 접속 URL (사내 LAN HTTP 예: http://210.x.x.x:3000)
# HTTPS가 아니면 http:// 로 두어 쿠키 secure 플래그가 꺼지도록 합니다.
NEXT_PUBLIC_BASE_URL="http://127.0.0.1:3000"

# Node 환경
NODE_ENV="production"
