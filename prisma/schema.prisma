  label       String   // 선택지명 (예: 본사, 센터)
  zipCode     String
  addressKo   String
  addressEn   String
  fax         String
  faxEn       String
  isActive    Boolean  @default(true) // 활성/비활성 토글
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------
// 🎓 명함 전용 자격사항/추가사항 표준단어 마스터
// -----------------------------------------------------------------
model BusinessCardQualification {
  id        String   @id @default(cuid())
  nameKo    String   // 국문 자격명 (예: 건축사)
  nameEn    String   // 영문 자격명 (예: Professional Engineer)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model OutsourcingVendor {
  id          String   @id @default(cuid())
  companyName String
  managerName String
  email       String
  memo        String   @default("") // 자유 기재 비고
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductionRequest {
  id              String   @id @default(cuid())
  postNumber      String   @unique // 예: P-SUP-PMD-260825-001
  category        String   // 품목 분류: "JEBON"(제본), "SIGN"(현판), "BANNER"(현수막), "MEDAL"(상패)
  
  // 🏢 부서 족보 데이터 (부서별 대조 및 조회 성능 최적화를 위한 인덱스 필드)
  userEmail       String   // 신청자 이메일
  userName        String   // 신청자 성명
  deptHead        String   // 소속 본부명
  deptName        String   // 세부 부서/센터명
  
  // 📝 맞춤 제작 공통 핵심 명세 (거래명세서 엑셀 대조 시 키값으로 매핑될 데이터)
  title           String   // 제작물 메인 타이틀 (예: "경영기획센터 현판", "인증기준 해설서 제본")
  quantity        Int      @default(1) // 신청 수량
  estimatedPrice  Int      @default(0) // 부서가 알고 있는 예상 단가 또는 규격 단가
  finalPrice      Int      @default(0) // 엑셀 명세서 대조 후 확정된 업체 청구 최종 금액

  // ⚙️ 품목별 동적 옵션 필드 (JSON 구조로 설계하여 컬럼 낭비 방지 및 무한 확장 보장)
  // - 제본인 경우: { "pageCount": 120, "isColor": true, "bindingType": "스프링" }
  // - 현판인 경우: { "material": "스테인레스", "size": "400x300", "installType": "다보" }
  options         Json     @default("{}")
  
  // 🚚 공정 통제 및 정산 라이프사이클 상태 플래그
  // - "PENDING"   신청 접수 전 (대기중)
  // - "ACCEPTED"  부서 접수 완료 · 묶음 발주 대기
  // - "ORDERED"   묶음 발주 완료 · 명세서 검수(inspection)
  // - "VERIFIED"  명세 대조·정산 승인
  // - "REJECTED"  부서 반려
  // - "CANCELLED" 대기중(미접수) 중 신청자 취소
  status          String   @default("PENDING") 
  
  // 🔗 묶음 정산 추적 벨트
  batchId         String?  // 부서 관리자가 한번에 묶어서 발주할 때 생성될 묶음 고유 ID (예: BATCH-경영기획-202607)
  isArchived      Boolean  @default(false) // 정산 마감 후 아카이브 보관함 이관 여부

  // 시스템 스탬프
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([deptName])
  @@index([status])
  @@index([batchId])
}

// -----------------------------------------------------------------
// 📦 ASSET: 제작물(Production) 전용 마스터 데이터 테이블 추가
// -----------------------------------------------------------------
model ProductionPlateMaster {
  id         String   @id @default(cuid())
  code       String   @unique // 예: CAST_IRON_300, TUNGSTEN_300
  label      String   // 예: 주물현판, 텅스텐현판
  price      Int      @default(0)
  size       String   // 예: 300*400, 90*55
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ProductionCertMaster {
  id             String   @id @default(cuid())
  certId         String   @unique // 예: GSEED, BF, CONDENDSATION, ISO, NORMAL
  type           String   // 소속 분류: "SIGN"(명판 전용) 또는 "JEBON"(제본 전용)
  label          String   // 예: 녹색건축인증, 결로방지 성능평가
  format         String   @default("") // 명판용 유효기간 출력 서식
  jebonFormat    String   @default("") // 제본용 완료일자 출력 서식
  grades         Json     @default("[]") // 등급 구조화 데이터 (예: ["최우수", "우수", "일반"])
  useCertNumber       Boolean  @default(true) // 신청폼 인증번호 입력 활성화
  useValidPeriod      Boolean  @default(true) // 신청폼 명판 유효기간 입력 활성화
  useMultiGradeSelect Boolean  @default(false) // 신청폼 등급 체크박스 복수 선택 (false=셀렉트 단일)
  // 📚 제본(JEBON) 신청폼 기본값 · 표지 활성화
  jebonDefaultSizeType String  @default("A4") // 판형 기본값 (A4/B5/…)
  jebonDefaultQuantity Int     @default(1) // 부수(수량) 기본값
  useJebonCover        Boolean @default(true) // 표지(Cover) 스펙 입력 활성화
  jebonCoverColor      String  @default("컬러") // 표지 인쇄 방식 기본값
  jebonCoverPageCount  String  @default("1") // 표지 면수 기본값
  jebonInnerColor      String  @default("흑백") // 본문 인쇄 방식 기본값
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ProductionVendorMaster {
  id           String   @id @default(cuid())
  label        String // 업체명
  managerName  String   @default("")
  contact      String   @default("")
  email        String   @default("")
  items        String   @default("") // 주요 제작 품목/비고
  /// 우선 연결 품목 (SIGN/JEBON/PRINT/OFFICE_SUPPLIES) — 품목당 1개 업체만 지정
  priorityCategory String @default("")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 기타제작물(PRINT) 주문 물품 마스터
// supplier = 최근 공급처(참고), orderQty = 제작 기본 수량(참고)
// unitValue = /admin/master-data 단위 그룹(unit_category_group) 코드 value
model ProductionPrintItemMaster {
  id         String   @id @default(cuid())
  name       String   // 제품명
  size       String   @default("") // 규격
  supplier   String   @default("") // 최근 공급처 (참고용)
  orderQty   Int      @default(1) // 제작 기본 수량 (참고용)
  unitValue  String   @default("VAL_1") // 단위 마스터 코드 value (예: VAL_1=개(EA))
  isCustom   Boolean  @default(false) // 기타소모품(직접입력) 여부
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}