// 📇 [교정 완료] 명함 신청 및 제작 상태 이력 관리 테이블 스키마
model BusinessCardRequest {
  id                String                  @id @default(cuid())
  postNumber        String                  // 관리 번호 (예: BC-2026-0001)
  userEmail         String                  // 신청자 계정
  createdAt         DateTime                @default(now())
  isArchived        Boolean                 @default(false) // 🚀 보관함 숨김 스위치 완벽 장착

  // ── [1] 국문 명함 정보 ──
  userName          String                  // 성명
  applyDate         String                  // 신청일자 (YYYY-MM-DD)
  processDate       String?                 // 관리자 처리일자 매핑용
  addressId         String?                 // 주소지 마스터 ID 매핑용
  deptHead          String                  // 본부 (드롭다운 선택 값)
  deptName          String                  // 소속 (드롭다운 선택 값)
  title             String                  // 직책/직급 (마스터 데이터 연동 값)
  additionalKo      String?                 // 추가사항 (자격 등)
  quantity          Int                     @default(1) // 명함 발주 신청 수량(통)

  mobile            String                  // 휴대전화 (예: 010-XXXX-XXXX)
  phone             String                  // 전화번호
  email             String                  // 이메일
  
  // ── [2] 시스템 일괄 적용 고정값 ──
  zipCode           String                  // 우편번호
  addressKo         String                  // 주소
  fax               String                  // 팩스번호

  // ── [3] 영문 명함 정보 ──
  userNameEn        String                  // 영문 이름
  deptHeadEn        String                  // 영문 본부
  deptNameEn        String                  // 영문 소속
  titleEn           String                  // 영문 직책
  additionalEn      String?                 // 영문 추가사항
  addressEn         String                  // 영문 주소
  mobileEn          String                  // 영문 휴대전화
  phoneEn           String                  // 영문 전화
  faxEn             String                  // 영문 팩스
  emailEn           String                  // 영문 이메일

  // ── [4] 프로세스 제어 상태 플래그 ──
  userStatus        String                  @default("1차작성")
  adminStatus       String                  @default("대기중")
  adminFeedback     String?                 @db.Text
  
  // ── [5] 묶음 대장과의 부모-자식 정식 1:N 관계 설정 ──
  orderGroupId      String?                 // 발주 묶음 아이디 외래키
  orderBatch        BusinessCardOrderBatch? @relation(fields: [orderGroupId], references: [id])
  
  // ── [6] 히스토리 로그 ──
  updatedAt         DateTime                @updatedAt
  processedBy       String?
  processedAt       DateTime?

  // 관리자 수정 추적용
  isModifiedByAdmin Boolean                 @default(false)
  adminMemo         String?   
  adminModifierName String?   
  adminModifiedAt   DateTime?

  // 신청 주체: 본인(/my-page) | 관리자대행(/requests)
  applicantType     String                  @default("본인")
  applicantName     String?
  applicantEmail    String? 

  @@index([userEmail])
  @@index([orderGroupId])
  @@index([adminStatus])
}

// 📦 [교정 완료] 명함 외주 발주 묶음(Batch) 마스터 통제 테이블
model BusinessCardOrderBatch {
  id            String                @id // 묶음 관리번호 (예: PO-BC-20260707-01)
  orderDate     String                // 발주 확정 일자 (YYYY-MM-DD)
  totalCount    Int                   // 묶음에 포함된 명함 총 건수
  deptHeadGroup String                // 기준 소속 (필터링용 대표 조직명)
  status        String                @default("발주완료") // 발주완료 / 지급완료 등
  isArchived    Boolean               @default(false) // 🚀 보관함 숨김 스위치 완벽 장착
  inspectStatus   String              @default("idle") // idle / match / mismatch
  inspectFileName String?
  inspectResult   Json?               // 거래명세표 교차 검증 스냅샷 (새로고침 유지)
  inspectedAt     DateTime?
  
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  
  items         BusinessCardRequest[] // 자식 테이블과의 연동 관계
}

// -----------------------------------------------------------------
// 🏢 시스템 공통 주소지 마스터 (명함, 배송 등 전사 공통 사용)
// -----------------------------------------------------------------
model CompanyAddress {
