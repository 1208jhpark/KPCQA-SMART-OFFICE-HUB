generator client {
  provider = "prisma-client-js"
}
     
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
     
// -----------------------------------------------------------------
// 1. 시스템 글로벌 설정
// -----------------------------------------------------------------
model SystemConfig {
  id                      String   @id @default("global")
  main_headline           String   @default("SMART OFFICE HUB")
  sub_headline            String   @default("서비스 모듈을 선택하세요.")
  home_grid_cols          Int      @default(4)
  layout_type             String   @default("horizontal")
  linked_sites            Json?    @default("[]")
  audit_baseline          String   @default("")
  global_mgmt_dept        String   @default("경영기획본부") 
  client_category_group   String   @default("") 
  supply_category_group   String   @default("") 
  unit_category_group     String   @default("") 
  it_category_group       String   @default("") // IT·업무자산 > 대범주 (HW/SW 등)
  it_rental_group         String   @default("") // IT·업무자산 > 조달 유형
  it_master_group         String   @default("") // IT·업무자산 > 품목
  job_duty_group          String   @default("")
  job_grade_group         String   @default("")
  bc_sheets_per_pack      Int      @default(200) // 명함 1통당 장수 (업체별 상이)
  bc_statement_col_map    Json?    // 거래명세표 칼럼 제목(이름/소속/수량/공급가액)
  bc_mail_shortcut_url    String   @default("")
  mkt_groupware_shortcut_url String @default("https://ep.kpcqa.or.kr/ea/edoc/eapproval/docCommonDrafWrite.do?template_key=8")
  // 🤝 외주 업무 서비스 — /admin/settings 마스터 그룹 매핑
  outsourcing_vendor_group  String @default("") // 외주 업체 마스터 그룹
  outsourcing_item_group    String @default("") // 외주 품목 리스트 그룹
  outsourcing_detail1_group String @default("") // 외주 품목 상세1 그룹
  outsourcing_detail2_group String @default("") // 외주 품목 상세2 그룹
  updatedAt               DateTime @updatedAt
}
     
// -----------------------------------------------------------------
// 2. 사용자 모델 (직책/직급 분리 완전체)
// -----------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   // 한글 성명
  name_en      String   @default("") // 영문 성명
  employee_no  String   @default("") // 사번
  password     String
  roles        Json     @default("[\"LV_3\"]")
  status       String   @default("Pending")
  unit_id      String?
  unit         OrgUnit? @relation(fields: [unit_id], references: [id])
  
  // 💡 [개념 분리] 직책(보직) 마스터 연동 필드
  duty         String   @default("") // 국문 직책 (예: 센터장)
  duty_en      String   @default("") // 영문 직책 (예: Manager)
  
  // 💡 [개념 분리] 직급(자격) 마스터 연동 필드
  grade        String   @default("") // 국문 직급 (예: 수석전문위원)
  grade_en     String   @default("") // 영문 직급 (예: Chief Expert Advisor)

  // 관리자 초기화 후 다음 로그인 시 비밀번호 변경 강제
  must_reset_password Boolean @default(false)

  // 로그인 화면에서 비밀번호 초기화 요청 (관리자 필터용)
  password_reset_requested    Boolean   @default(false)
  password_reset_requested_at DateTime?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// -----------------------------------------------------------------
// 3. 조직/부서 마스터
// -----------------------------------------------------------------
model OrgUnit {
  id           String    @id @default(cuid())
  unit_name    String    // 국문 부서명 (예: 경영자산관리팀)
  
  // 💡 [신설] 명함 시스템 자동 링크용 영문 조직명 필드 추가
  unit_name_en String    @default("") // 영문 부서명 (예: Management & Asset Team)

  /// 제작물 관리번호용 조직 고정 코드 (본부=D · 센터=C, 예: PMD, PMC, GBC)
  unit_code    String    @unique @default("")

  unit_type    String
  sort_order   Int       @default(0)
  parent_id    String?
  parent       OrgUnit?  @relation("UnitHierarchy", fields: [parent_id], references: [id])
  children     OrgUnit[] @relation("UnitHierarchy")
  users           User[]
  supplyRequests  SupplyRequest[]
  is_active       Boolean   @default(true)
  is_deleted      Boolean   @default(false)
  /// 부서 소모품 보관 위치 안내 (부서 대장 페이지에서 편집)
  supply_storage_note String @default("") @db.Text
}
 
// -----------------------------------------------------------------
// 4. 시스템 메뉴 및 권한 제어
// -----------------------------------------------------------------
model InterfaceConfig {
  id               String   @id @default(cuid())
  path             String   @unique
  level            Int      @default(4)
  name             String
  description      String?  @default("")
  icon             String?  @default("📦")
  sort_order       Int      @default(0)
  is_active        Boolean  @default(true)
  is_visible       Boolean  @default(true)
  parent_id        String?
  parent           InterfaceConfig?  @relation("MenuHierarchy", fields: [parent_id], references: [id])
  children         InterfaceConfig[] @relation("MenuHierarchy")
  view_scopes      Json?    @default("[]")
  org_ids          Json?    @default("[]")
  edit_role_ids    Json?    @default("[]")
  edit_scopes      Json?    @default("[]") 
  task_masters     Json?    @default("[]") 
  view_role_ids    Json?
  task_accesses    Json?
  is_master        Boolean  @default(false)
  master_editor_id String?                  
  entry_sidebar    Boolean  @default(true)
  entry_index_view Boolean  @default(true)
  entry_l4_direct  Boolean  @default(false)
  l2_entry_mode    String?  @default("L3_DEFAULT")
  show_header      Boolean  @default(false)
  page_title       String?  
  show_page_title  Boolean  @default(false) 
  page_description String?  
  show_page_desc   Boolean  @default(false) 
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
     
// -----------------------------------------------------------------
// 5, 6. 마스터 그룹 및 코드
// -----------------------------------------------------------------
model MasterGroup {
  id          String       @id
  name        String       @unique
  category    String?
  description String?
  sort_order  Int          @default(0)
  is_active   Boolean      @default(true)
  codes       MasterCode[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
     
model MasterCode {
  id          String      @id @default(cuid())
  group_id    String
  group       MasterGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  label       String
  value       String?
  sort_order  Int         @default(1)
  orgs        String[]
  min_qty     String?
  unit        String?
  price       Float?
  vendor      String?
  is_active   Boolean     @default(true)
  is_visible  Boolean     @default(true)
  is_archived Boolean     @default(false)
  in_use      Boolean     @default(false)
}
     
// -----------------------------------------------------------------
// 7. IT 정보 자산 관리
// -----------------------------------------------------------------
model ITAsset {
  id              String   @id @default(cuid())
  category        String   // <--- 여기에 범주(HW/SW 등) 저장
  it_type         String   // <--- 여기에 분류(노트북 등) 저장
  dept            String   
  user            String?  @default("공용")
  /// 자산 담당자 안정 식별자 (동명이인 방지) — 표시명은 user 유지
  user_email      String?
  user_id         String?
  code            String   @unique 
  model           String
  sn              String?
  brand           String?
  spec            String?
  is_rental       String   @default("구매")  // <--- 여기에 조달유형(구매/렌탈) 저장
  rental_months   Int      @default(0)
  purchase_price  Float    @default(0)
  monthly_fee     Float    @default(0)
  in_date         String?
  start_date      String?
  end_date        String?
  first_bill      String?
  cycle           Int      @default(48)
  memo            String?  @default("-")
  reg_date        String?
  /// 등록 경로: excel(엑셀 업로드) | manual(신규 자산 추가) — 당일 행 하이라이트용
  entry_source    String?
  is_active       Boolean  @default(true) 
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  last_audit_date    String?   // 최근 실사 인증 완료일
  /// 실사 완료 주체: user(본인·QR) | admin(관리자 강제 확인)
  last_audit_by      String?
  audit_request_date String?   // 관리자 실사 독촉(요청)일
  /// 사용자 정보수정 제안 (승인 전). { proposed, changedKeys, requestedAt, requestedBy }
  info_correction_pending Json?

  @@index([user_email])
  @@index([user_id])
}
     
// -----------------------------------------------------------------
// 8, 9. 장비 관리 및 이력
// -----------------------------------------------------------------
model Equipment {
  id                String   @id @default(cuid())
  category          String   
  name              String   
  model_name        String   
  serial_no         String?  // 시리얼번호 — model_name(모델번호)과 분리
  brand             String?  
  asset_no          String   @unique 
  purpose           String?  
  spec_summary      String?  
  full_spec         String?  
  thumbnail_url     String?  
  gallery_urls      Json?    @default("[]") 
  department        String?  
  qty               Int      @default(1) 
  purchase_date     DateTime? 
  replace_cycle_mo  Int?     
  last_replace_date DateTime?
  next_replace_date DateTime?
  calib_cycle_mo    Int      @default(12) 
  next_calib_date   DateTime? 
  calib_memo        String?  
  status            String   @default("정상") 
  manual_url        String?  
  cert_url          String?  
  etc_url           String?  
  etc_memo          String?  
  

  // 감사 — 등록/수정/폐기 (UI: 상세 팝업 하단, 목록·썸네일 미표시)
  creator_name       String?
  creator_dept       String?
  creator_email      String?
  updated_by_name    String?
  updated_by_dept    String?
  updated_by_email   String?
  archived_at        DateTime?
  archived_by_name   String?
  archived_by_dept   String?
  archived_by_email  String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  histories         CalibrationHistory[]
  maintenance_histories MaintenanceHistory[] // 🚀 추가: 구매/유지보수 이력 관계
}


model MaintenanceHistory {
  id           String    @id @default(cuid())
  equipment_id String
  equipment    Equipment @relation(fields: [equipment_id], references: [id], onDelete: Cascade)

  type        String // 구분: 구매, 수리, 소모품교체 등
  date        DateTime // 처리 일자
  vendor      String? // 처리 업체
  content     String? // 상세 내용
  cost        Float?  @default(0) // 비용
  receipt_url String? // 영수증/증빙 파일
  memo        String?

  creator_name  String?
  creator_dept  String?
  creator_email String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model CalibrationHistory {
  id              String   @id @default(cuid())
  equipment_id    String
  equipment       Equipment @relation(fields: [equipment_id], references: [id], onDelete: Cascade)
  calib_request_date String?   
  calib_date      DateTime 
  agency          String   
  content         String?  
  result          String   
  cost            Float?   @default(0) 
  estimate_url    String?  
  cert_file_url   String?  
  receipt_url     String?  
  next_calib_date DateTime? 
  memo            String?

  // 검교정 이력 등록자
  creator_name  String?
  creator_dept  String?
  creator_email String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
     
// -----------------------------------------------------------------
// 10~13. 마케팅 물품 관리
// -----------------------------------------------------------------
model MarketingItem {
id            String   @id @default(cuid())
  owner_type    String   @default("CENTER") 
  owner_dept    String?  
  name          String   
  unit_price    Float    @default(0) 
  current_stock Int      @default(0) 
  alert_qty     Int      @default(0) 
  image_url     String?  @default("") 
  description   String?  @default("") 
  unit          String?  @default("EA")   
  is_archived   Boolean? @default(false)  

  // 🚀 [추가] 등록(또는 종료 처리) 담당자 정보 화석화
  creator_name  String?  // 등록자 이름
  creator_dept  String?  // 등록자 부서
  creator_email String?  // 동명이인 방지 — 등록자 매칭 키

  // GLOBAL_MGMT(+직속 하위)만 설정 — 미지정=타부서 숨김, 지정 시 해당 LV만 타부서 카드 노출
  view_role_ids Json?    @default("[]")
  // 열람 LV로 지정된 타부서 인원에게 지급 신청도 허용할지
  view_allow_apply Boolean @default(false)

  // 종료(아카이브) 처리자 — 부서지급대장 종료 탭 표시용
  archived_by_name  String?
  archived_by_dept  String?
  archived_by_email String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  distributions MarketingDistribution[]
  purchases     MarketingPurchase[]
}
     
model MarketingDistribution {
  id              String   @id @default(cuid())
  item_id         String
  item            MarketingItem @relation(fields: [item_id], references: [id])
  client_id       String?
  client_master   MarketingClient? @relation(fields: [client_id], references: [id])
  client_name     String
  client_dept     String?
  qty             Int      @default(1)
  purpose         String?
  sender_name     String
  sender_dept     String
  sender_email    String?  // 동명이인 방지 — 본인 매칭 키
  /** PENDING=승인요청 / CONFIRMED=지급확정 / REJECTED=반려(이력만, 수량집계 제외) */
  status          String   @default("CONFIRMED")
  /** 승인 처리 시각 — 최근 승인 건 하이라이트용 (바로신청은 null) */
  approved_at     DateTime?
  /** 반려 사유 · 반려 시각 */
  reject_reason   String?
  rejected_at     DateTime?
  dist_date       DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([status])
  @@index([client_id])
  @@index([client_id, dist_date])
  @@index([status, dist_date])
}
     
model MarketingClient {
  id          String   @id @default(cuid())
  name        String   
  location    String?  
  category    String?  
  departments Json?    @default("[]") 
  is_active   Boolean  @default(true)
  is_archived Boolean  @default(false) // 보관함 (운영목록에서만 숨김)
  archived_at       DateTime? // 보관함 처리 시각
  archived_by_name  String?   // 보관 처리자
  archived_by_dept  String?   // 처리자 소속
  archived_by_email String?   // 동명이인 대비 (UI 미표시)
  creator_name  String?  // 신규 등록자
  creator_dept  String?
  creator_email String?  // 등록자 매칭 — 미사용(지급 0건) 시 본인 영구삭제 허용
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  distributions MarketingDistribution[]
}
     
model MarketingPurchase {
  id              String   @id @default(cuid())
  item_id         String
  qty             Int      @default(0)
  unit_price      Float    @default(0)
  total_price     Float    @default(0)
  note            String?
  purchaser_name  String
  purchaser_dept  String
  purchaser_email String?  // 동명이인 방지 — 입고자 매칭 키
  purchase_date   DateTime @default(now())
  createdAt       DateTime @default(now())
  item            MarketingItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  // 🚀 기존 데이터를 살리기 위해 DB의 기존 'vendor' 컬럼을 매핑 보존합니다.
  old_vendor      String?  @map("vendor")

  // 🚀 외주 업체 테이블과 ID로 정식 연결 관계 구축
  vendor_id       String?
  vendor          Vendor?    @relation(fields: [vendor_id], references: [id], onDelete: SetNull)
}
     
// -----------------------------------------------------------------
// 📦 ASSET: 일반 소모품 관리
// -----------------------------------------------------------------
model SupplyItem {
  id              String   @id @default(cuid())
  name            String
  unit_price      Int      @default(0)
  current_stock   Int      @default(0)
  alert_qty       Int      @default(0)
  owner_dept      String
  category        String
  description     String?  @db.Text
  image_url       String?  @db.Text
  is_active       Boolean  @default(true)
  is_published    Boolean  @default(false) 
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  requests        SupplyRequest[]
  purchases       SupplyPurchase[]
}
     
model SupplyPurchase {
  id              String   @id @default(cuid())
  item_id         String
  qty             Int      
  unit_price      Int      
  total_price     Int      
  note            String?  
  purchase_date   DateTime @default(now()) 
  purchaser_name  String   
  purchaser_dept  String   
  createdAt       DateTime @default(now())
  item            SupplyItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
       
  // 🚀 기존 데이터를 살리기 위해 DB의 기존 'vendor' 컬럼을 매핑 보존합니다.
  old_vendor      String?  @map("vendor")

  // 🚀 외주 업체 테이블과 ID로 정식 연결 관계 구축
  vendor_id       String?
  vendor          Vendor?    @relation(fields: [vendor_id], references: [id], onDelete: SetNull)
}
     
model SupplyRequest {
  id             String   @id @default(cuid())
  item_id        String
  item           SupplyItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  qty            Int      
  user_email     String   
  user_name      String   
  /// 신청 시점 조직명 스냅샷 (표시용)
  dept_name      String
  /// 신청 소속 조직 ID (스코프·필터 기준). 레거시 행은 null 가능
  unit_id        String?
  unit           OrgUnit? @relation(fields: [unit_id], references: [id], onDelete: SetNull)
  status         String   @default("PENDING") 
  note           String?  @db.Text 
  createdAt      DateTime @default(now())
  admin_opinion  String?  
  admin_name     String?  
  admin_dept     String?  
  /// 지급완료·반려 등 처리 확정 시각 (철회로 대기 복귀 시 null)
  processedAt    DateTime?
  updatedAt      DateTime @updatedAt 

  @@index([unit_id])
  @@index([user_email])
}
     
// -----------------------------------------------------------------
// 📦 ASSET: 외주 업무 서비스 마스터
// -----------------------------------------------------------------
model Vendor {
  id                 String              @id @default(cuid())
  name               String              // 업체명 (예: "한생미디어", "아트로릭")
  services           String[]            // 취급 품목 리스트 (예: ["제본", "쇼핑백", "상장케이스"])
  contact            String?             // 담당자 연락처
  category           String?             // 인쇄, 물류, 비품 등 구분
  is_active          Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  
  // 역관계 설정: 이 외주업체가 납품한 모든 구매 내역들을 추적합니다.
  supplyPurchases    SupplyPurchase[] 
  marketingPurchases MarketingPurchase[]
}

// 📦 배달 복지 설문 모델 (localStorage 데이터를 DB로 이관)
model DeliverySurvey {
  id               String   @id @default(cuid())
  code             String
  postNumber       Int
  title            String
  description      String?  @db.Text
  type             String
  deliveryType     String
  target           String
  isAnonymous      Boolean  @default(false)
  postDate         String
  startDate        String
  endDate          String
  status           String   @default("게시전")
  hasBeenPublished Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  questions        Json?    @default("[]")
  responses        DeliveryResponse[] 
  nudgedUsers String[] @default([])
  endTime   String?  @default("23:59") // 종료 시간 (기본값 밤 12시 1분 전)
}

// -----------------------------------------------------------------
// 📝 배달 복지 신청 실제 응답 대장 (새로 추가하는 모델)
// -----------------------------------------------------------------
model DeliveryResponse {
  id            String         @id @default(cuid())
  
  // 💡 위 DeliverySurvey 테이블과 연결되는 외래키(ForeignKey) 설정
  surveyId      String   
  survey        DeliverySurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  
  userEmail     String   
  submittedAt   DateTime       @default(now()) 
  answers       Json     
  isApproved    Boolean        @default(false)  
  approvedAt    DateTime?                 
  feedbackMsg   String?        @db.Text         
  feedbackAt    DateTime?                 
  isRevoked     Boolean        @default(false)  
  revisionCount Int            @default(0)      

  @@unique([surveyId, userEmail]) 
}

// -----------------------------------------------------------------
// 📝 배달 신청 주고·관리자 의견 타임라인 (전 이력)
// type: USER_SUBMIT | ADMIN_FEEDBACK | ADMIN_APPROVE | ADMIN_CANCEL
// -----------------------------------------------------------------
model DeliveryResponseEvent {
  id         String   @id @default(cuid())
  surveyId   String
  userEmail  String
  type       String
  revisionNo Int?
  message    String?  @db.Text
  answers    Json?
  actorEmail String?
  actorName  String?
  createdAt  DateTime @default(now())

  @@index([surveyId, userEmail, createdAt])
}

// -----------------------------------------------------------------
// 📝 일반 설문조사 모델 (General Survey)
// -----------------------------------------------------------------
model GeneralSurvey {
  id               String   @id @default(cuid())
  code             String
  postNumber       Int
  title            String
  description      String?  @db.Text
  type             String   // 선택형, 자유응답형 등
  isAnonymous      Boolean  @default(false) // 익명 여부
  target           String   // 전사, 특정부서 지정 등
  postDate         String
  startDate        String
  endDate          String
  status           String   @default("게시전")
  hasBeenPublished Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  questions        Json?    @default("[]")
  nudgedUsers      String[]          @default([])
  endTime   String?  @default("23:59") // 종료 시간 (기본값 밤 12시 1분 전)

  // 🚀 [추가 필수]: GeneralResponse와의 1:N 양방향 관계 설정
  responses        GeneralResponse[] 
}

// -----------------------------------------------------------------
// 📝 일반 설문 응답 대장 (General Response) - 신규 추가
// -----------------------------------------------------------------
model GeneralResponse {
  id          String   @id @default(cuid())
  
  // 외래키 설정
  surveyId    String
  survey      GeneralSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  
  userEmail   String
  submittedAt DateTime @default(now())
  answers     Json     // 응답 데이터 저장 (배열/객체 혼합)
  isApproved  Boolean  @default(false) // 프론트엔드의 마이페이지 렌더링에 사용됨

  // 중복 제출 방지를 위한 복합 유니크 키
  @@unique([surveyId, userEmail])
}

// 🚀 IT 자산 실사 마스터 테이블
model ITAudit {
  id          String   @id @default(uuid())
  title       String
  description String?
  target      String   // 대상 부서 (예: "전사", "KPCQA")
  startDate   String
  endDate     String
  endTime     String?  @default("23:59") // 종료 시각 (KST HH:mm, 도래 시 자동 마감)
  status      String   @default("작성중") // 작성중, 진행중, 게시중단, 마감, 보관됨
  postDate    String?
  archivedAt  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  responses   ITAuditResponse[]
}

// 🚀 IT 자산 실사 개별 응답 테이블
model ITAuditResponse {
  id        String   @id @default(uuid())
  auditId   String
  audit     ITAudit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  userEmail String   // 참여자 이메일
  isDone    Boolean  @default(false)
  date      String?  // 인증 완료일
  createdAt DateTime @default(now())

  @@unique([auditId, userEmail])
}

// 🚀 IT 자산 관련 요구사항 및 의견 송수신 테이블
model ITRequest {
  id           String   @id @default(uuid())
  requestDate  String   // 요청 일자 (YYYY-MM-DD)
  requester    String   // 요청자 이름(표시용)
  /// 요청자 안정 식별자 (동명이인 방지)
  requester_email String?
  requester_id    String?
  dept         String   // 요청자 부서
  assetInfo    String   // 대상 자산 요약 (자산코드 / 모델명)
  assetCode    String   // 자산 식별 코드
  assetType    String   // 자산 분류 (노트북, 모니터 등)
  content      String   // 요구사항/의견 내용 (텍스트)
  status       String   @default("의견전송") // 의견전송, 관리자 의견발송, 처리완료, 답변 대기중 등
  adminOpinion String?  // 관리자 답변/검토 의견
  completedAt  String?  // 처리 및 조치 완료 일자
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([requester_email])
  @@index([requester_id])
}

